using script reflection

# pacskage's helpers are local functions, so each one used here is looked up by
# name from the core script, which pacskage passes in as {_core}. the wrappers
# keep pacskage's own names and take core as their first argument
local function core_function(core: Object, name: String) -> Object:
    return the function named {_name} from {_core}

local function pkg_list(core: Object) -> Strings:
    set {_f} to core_function({_core}, "pkg_list")
    return the result of {_f}

local function pkg_bare(core: Object, folder: String) -> String:
    set {_f} to core_function({_core}, "pkg_bare")
    return the result of {_f} with arguments {_folder}

local function pkg_resolve(core: Object, name: String) -> String:
    set {_f} to core_function({_core}, "pkg_resolve")
    return the result of {_f} with arguments {_name}

local function pkg_dir(core: Object, name: String) -> String:
    set {_f} to core_function({_core}, "pkg_dir")
    return the result of {_f} with arguments {_name}

local function manifest(core: Object, dir: String, key: String) -> String:
    set {_f} to core_function({_core}, "manifest")
    return the result of {_f} with arguments {_dir}, {_key}

local function trim(core: Object, text: String) -> String:
    set {_f} to core_function({_core}, "trim")
    return the result of {_f} with arguments {_text}

local function dir_rename(core: Object, from: String, to: String):
    set {_f} to core_function({_core}, "dir_rename")
    run {_f} with arguments {_from}, {_to}

# bare names of the enabled packages, the ones that get a load-order prefix
local function pkg_enabled_names(core: Object) -> Strings:
    set {_folders::*} to (pkg_list({_core}) where [input does not start with "-"])
    return ({_folders::*} transformed with [pkg_bare({_core}, input)])

# a dependency entry (url or bare name) as an installed package's name
# (an origin match comes back as its folder name, see pkg_by_origin)
local function pkg_dep_name(core: Object, entry: String) -> String:
    set {_entry} to (trim({_core}, {_entry}) ? "")
    if {_entry} contains "://":
        set {_found} to pkg_by_origin({_entry})
        if {_found} is set:
            return {_found}
    set {_dep} to pkg_name({_entry})
    if {_dep} is not set:
        stop
    return {_dep}

local function pkg_dep_names(core: Object, name: String) -> Strings:
    set {_dir} to pkg_resolve({_core}, {_name})
    if {_dir} is not set:
        stop
    set {_raw} to manifest({_core}, {_dir}, "packages")
    if {_raw} is not set:
        stop
    for {_entry} in split {_raw} at ",":
        set {_dep} to pkg_dep_name({_core}, {_entry})
        if {_dep} is set:
            add pkg_bare({_core}, {_dep}) to {_names::*}
    return {_names::*}

# true while a dependency is still waiting to be placed. deps that are
# disabled, missing or self-referencing don't count
local function pkg_has_pending_deps(core: Object, name: String, pending: Strings) -> Boolean:
    for {_dep} in pkg_dep_names({_core}, {_name}):
        if all:
            {_dep} is not {_name}
            {_pending::*} contains {_dep}
        then:
            return true
    return false

# two-digit folder prefix for a load-order layer: 1 -> 01
local function pkg_layer_prefix(layer: Integer) -> String:
    set {_text} to "%{_layer}%"
    while length of {_text} < 2:
        set {_text} to "0%{_text}%"
    return {_text}

# renames one package folder to <layer>~<name>
local function pkg_set_load_order(core: Object, name: String, layer: Integer):
    set {_current} to pkg_resolve({_core}, {_name})
    set {_target} to pkg_dir({_core}, "%pkg_layer_prefix({_layer})%~%{_name}%")
    if {_current} is not {_target}:
        dir_rename({_core}, {_current}, {_target})

# each pass places every package whose deps are already placed, and all of
# them share that pass's number. a pass that places nothing means a cycle:
# the remaining packages are reported and share the last layer
function pkg_reorder_by_load_order(core: Object, sender: Object):
    set {_pending::*} to pkg_enabled_names({_core})
    if {_pending::*} is not set:
        send "[pacskage-reorder] no enabled packages found to order" to {_sender}
        stop
    set {_layer} to 1
    set {_count} to 0
    while {_pending::*} is set:
        set {_batch::*} to ({_pending::*} where [pkg_has_pending_deps({_core}, input, {_pending::*}) is false])
        if {_batch::*} is not set:
            send "[pacskage-reorder] circular package dependencies among: %{_pending::*}%" to {_sender}
            set {_batch::*} to {_pending::*}
        loop {_batch::*}:
            pkg_set_load_order({_core}, loop-value, {_layer})
        add size of {_batch::*} to {_count}
        remove {_batch::*} from {_pending::*}
        add 1 to {_layer}
    send "[pacskage-reorder] ordered %{_count}% package(s)" to {_sender}
